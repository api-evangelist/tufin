        {
          "id": "9f8da445-ec79-445b-be73-1e8667dad325",
          "name": "Get Network Path",
          "request": {
            "name": "Get Network Path",
            "description": {
              "content": "Query the network topology to determine whether traffic is permitted between source and destination endpoints, and which devices are traversed.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "topology",
                "path"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "src",
                  "value": "<string>",
                  "description": "(Required) Source IP address or CIDR range"
                },
                {
                  "disabled": false,
                  "key": "dst",
                  "value": "<string>",
                  "description": "(Required) Destination IP address or CIDR range"
                },
                {
                  "disabled": false,
                  "key": "service",
                  "value": "<string>",
                  "description": "Service (protocol/port, e.g., tcp/443)"
                }
              ],
              "variable": [
                {
                  "description": "Hostname or IP address of the TOS server",
                  "type": "any",
                  "value": "{{tos_host}}",
                  "key": "tos_host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
