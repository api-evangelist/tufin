{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tufin SecureChange REST Compliance Zones API",
    "version": "R25-2"
  },
  "items": [
    {
      "info": {
        "name": "Zones",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Security Zones",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tos_host}/securechangeworkflow/api/securechange/zones",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve all security zones defined across managed devices."
        }
      ]
    }
  ],
  "bundled": true
}